{
  "name": "screenstudio-pro",
  "version": "0.8.5",
  "description": "ScreenStudio Pro - Professional multi-track video editor",
  "main": "dist/main/main.js",
  "homepage": "./",
  "author": "ScreenStudio Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "dev:electron": "wait-on dist/main/main.js && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "package": "electron-builder",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 200",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "typecheck:renderer": "tsc -p tsconfig.json --noEmit",
    "ci": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "lucide-react": "^0.358.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.6.0"
  },
  "build": {
    "appId": "com.screenstudio.pro",
    "productName": "ScreenStudio Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
